{
  "retrier": {
    "enabled": true,
    "environment": "jet-auto-retrier",
    "default_retry_on": ["1.2", "1.2.*"],
    "default_max_retries": 1,
    "waiting_time": 60
  },
  "executors": {
    "jet-ci": {
      "environments": {
        "jet-auto-retrier": {
          "tags": ["<retrier runner tag>"],
          "image": "<JET API image>",
          "before_script": ["<JET secrets login command>"]
        }
      }
    }
  }
}

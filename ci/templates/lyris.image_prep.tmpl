srun
  -l
  --account=${account}
  --partition=${partition}
  --time=00:${time_minutes}:00
  --mem=0
  --nodes=1
  --gpus-per-node=${gpus_per_node}
  --container-mounts=${home}:${home},${home}:/root,/lustre:/lustre
  --container-image=${image_base}
  --container-save=${image_out}
  --container-writable

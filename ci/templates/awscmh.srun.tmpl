srun
  --account=nemotron_sw_resiliency
  --partition=${partition}
  --nodes=${nodes}
  --ntasks=${ntasks}
  --time=00:${time_minutes}:00
  --gpus-per-node=${gpus_per_node}
  --mem=0
  --job-name=${job_name}
  --container-image=${image}
  --container-mounts=${home}:${home},/lustre:/lustre,/scratch:/scratch
  --container-env=${container_env}

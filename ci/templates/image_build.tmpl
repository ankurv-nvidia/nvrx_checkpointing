#!/bin/bash
# Default enroot squash-image build — models cw-dfw (CoreWeave DFW).
#
# run_job.py substitutes the ${...} placeholders (lowercase names; shell ${UPPER}
# vars are left untouched) and runs this with `bash -c` when the project image is
# missing. It mirrors the build flow in scripts/enroot.sh: import the base
# PyTorch image if absent, then run prepare.sh inside it and save the result.
#
# To customize for another cluster, copy this file next to your runner config
# (e.g. ~/data/ci/image_build.tmpl) and edit it (account, partition, mounts,
# GPU flags, ...). When absent there, this repo default is used.
#
# Placeholders: ${home} ${image_base} ${image_out} ${docker_image}
#               ${prepare_sh} ${gpus_per_node}
set -Eeuox pipefail

# Import the base PyTorch image from the registry if it isn't already present.
if [[ ! -e "${image_base}" ]]; then
  srun -l --account=coreai_resiliency_osiris --partition=interactive --time=00:60:00 --mem=0 \
    --comment='{"OccupiedIdleGPUsJobReaper":{"exemptIdleTimeMins":"60","reason":"other","description":"native checkpoint CI image build"}}' \
    enroot import --output "${image_base}" "docker://${docker_image}"
fi

# Build the project image: run prepare.sh inside the base image and save it.
# The build itself does not need GPUs, but some schedulers require the request.
#
# $HOME is NOT bind-mounted to /root: each build gets the container's own ephemeral
# /root, so its uv/pip cache (~/.cache) is per-build. Mounting the host $HOME here
# would make every build share ~/.cache/uv, and concurrent cold-start builds then
# collide on its lock (300s timeout) or corrupt it (`uv cache clear` bus error).
# The image's packages still install to the system site-packages, so they are saved;
# only the throwaway per-build cache lives in the unmounted /root.
srun -l --account=coreai_resiliency_osiris --partition=interactive --time=00:60:00 --mem=0 \
  --comment='{"OccupiedIdleGPUsJobReaper":{"exemptIdleTimeMins":"60","reason":"other","description":"native checkpoint CI image build"}}' \
  --gpus-per-node=${gpus_per_node} \
  --container-mounts "${home}:${home},/lustre:/lustre" \
  --container-image "${image_base}" \
  --container-save "${image_out}" \
  --container-writable \
  bash -c "bash ${prepare_sh} ubuntu2404 megatron test"

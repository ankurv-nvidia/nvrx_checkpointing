# Auto detect text files and perform LF normalization
* text=auto

# Declare files that will always have Windows CRLF line endings on checkout.
*.sln text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Declare files that will always have UNIX LF line endings on checkout.
*.sh text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.tar binary
*.tgz binary
*.gz binary
*.xz binary
*.zip binary
*.exe binary
*.snappy binary
*.onnx binary

*.gif diff=image
*.jpg diff=image
*.jpeg diff=image
*.png diff=image

# The CI checkpoint baselines are xz-compressed text. Decompress them for
# `git diff`/`git show` so baseline updates stay reviewable. One-time opt-in:
#   git config diff.xztext.textconv 'xz -dcq'
metadata/**/reference.metadata.info.xz diff=xztext

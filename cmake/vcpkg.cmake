macro (_vcpkg_init_build_platform)
    # List of supported platforms : windows, uwp ,android ,linux
    if (NOT DEFINED SUPPORTED_PLATFORMS)
        if (ANDROID)
            list(APPEND SUPPORTED_PLATFORMS "android")
        endif()
        if (EMSCRIPTEN)
            list(APPEND SUPPORTED_PLATFORMS "emscripten")
        endif()
        if (CMAKE_SYSTEM_NAME STREQUAL "WindowsStore")
            list(APPEND SUPPORTED_PLATFORMS "uwp")
        endif()
        if (CMAKE_SYSTEM_NAME STREQUAL "Linux")
            list(APPEND SUPPORTED_PLATFORMS "linux")
        endif()
        if (WIN32)
            list(APPEND SUPPORTED_PLATFORMS "windows")
        endif()
        if (MSVC)
            list(APPEND SUPPORTED_PLATFORMS "winrt")
        endif()
        if (MINGW)
            list(APPEND SUPPORTED_PLATFORMS "mingw")
        endif()
        if (APPLE)
            list(APPEND SUPPORTED_PLATFORMS "osx")
        endif()
        set(SUPPORTED_PLATFORMS "${SUPPORTED_PLATFORMS}" CACHE STRING "Build Platform")
    endif()
    if ("${SUPPORTED_PLATFORMS}" STREQUAL "")
        unset(SUPPORTED_PLATFORMS CACHE)
        unset(SUPPORTED_PLATFORMS)
        message(FATAL_ERROR "No Supported platforms detected")
    endif()
endmacro()

macro (_vcpkg_init_build_arch)
    if (NOT BUILD_ARCH)
        if (CMAKE_SYSTEM_PROCESSOR STREQUAL "x86_64")
            set(BUILD_ARCH x64)
        elseif (CMAKE_SYSTEM_PROCESSOR STREQUAL "AMD64")
            set(BUILD_ARCH x64)
        elseif (CMAKE_SYSTEM_PROCESSOR STREQUAL "i686")
            set(BUILD_ARCH x86)
        elseif (CMAKE_SYSTEM_PROCESSOR STREQUAL "armv7l")
            set(BUILD_ARCH arm)
        elseif (CMAKE_SYSTEM_PROCESSOR STREQUAL "armv6")
            set(BUILD_ARCH arm)
        elseif (CMAKE_SYSTEM_PROCESSOR STREQUAL "armv7-a")
            set(BUILD_ARCH arm)
        elseif (CMAKE_SYSTEM_PROCESSOR MATCHES "[aA](arch|rm|RM)64")
            set(BUILD_ARCH arm64)
        elseif (CMAKE_SYSTEM_NAME STREQUAL Emscripten)
            set(BUILD_ARCH wasm32)
        else()
            message(FATAL_ERROR ${CMAKE_SYSTEM_PROCESSOR} :: ${CMAKE_SYSTEM_NAME})
        endif()
    endif()
endmacro()

macro (_vcpkg_init_host_arch)
    if (NOT HOST_ARCH)
        if (CMAKE_HOST_SYSTEM_PROCESSOR STREQUAL "x86_64")
            set(HOST_ARCH x64)
        elseif (CMAKE_HOST_SYSTEM_PROCESSOR STREQUAL "AMD64")
            set(HOST_ARCH x64)
        elseif (CMAKE_HOST_SYSTEM_PROCESSOR STREQUAL "i686")
            set(HOST_ARCH x86)
        elseif (CMAKE_HOST_SYSTEM_PROCESSOR STREQUAL "armv7l")
            set(HOST_ARCH arm)
        elseif (CMAKE_HOST_SYSTEM_PROCESSOR STREQUAL "armv6")
            set(HOST_ARCH arm)
        elseif (CMAKE_HOST_SYSTEM_PROCESSOR STREQUAL "armv7-a")
            set(HOST_ARCH arm)
        elseif (CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "[aA](arch|rm|RM)64")
            set(HOST_ARCH arm64)
        else()
            message(FATAL_ERROR ${CMAKE_HOST_SYSTEM_PROCESSOR} :: ${CMAKE_SYSTEM_NAME})
        endif()
    endif()
endmacro()

function(_vcpkg_is_packages_applicable outvar)
    get_property(available_ports_json GLOBAL PROPERTY VCPKG_AVAILABLE_PORTS)
    if ("${available_ports_json}" STREQUAL "")
        set(available_ports_json "{}")
    endif()
    foreach(l ${ARGN})
        if (NOT "${l}" MATCHES ".*:.*")
            set(l "${l}:${VCPKG_TARGET_TRIPLET}")
        endif()
        string(JSON test ERROR_VARIABLE notfound GET "${available_ports_json}"  "${l}")
        if ("${test}" STREQUAL "${l}-NOTFOUND")
            list(APPEND failed "${l}")
        endif()
    endforeach()
    if ("${failed}" STREQUAL "")
        set(${outvar} TRUE PARENT_SCOPE)
    else()
        set(${outvar}_FAILED "${failed}" PARENT_SCOPE)
        set(${outvar} FALSE PARENT_SCOPE)
    endif()
endfunction()

macro(vcpkg_init)
    _vcpkg_init_build_platform()
    _vcpkg_init_build_arch()
    _vcpkg_init_host_arch()
    cmake_policy(SET CMP0077 NEW)
    set(VCPKG_USE_HOST_TOOLS ON)
    set(VCPKG_SETUP_CMAKE_PROGRAM_PATH ON)
    set(LINUX_TRIPLET_POSTFIX "linux")
    DetectArchNative()
    if (NOT BUILDENV_DISABLE_MARCH_NATIVE)
        string(APPEND LINUX_TRIPLET_POSTFIX "-native")
    endif()
    if (CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
        if (NOT DEFINED VCPKG_HOST_TRIPLET)
            # Could be mingw or msvc
            find_program(vswhere NAMES vswhere QUIET HINTS "C:/Program Files (x86)/Microsoft Visual Studio/Installer")
            if (EXISTS "${vswhere}")
            # this is only when visual studio is preinstalled
            # portable vs will use mingw
                set(VCPKG_HOST_TRIPLET "${HOST_ARCH}-windows-static-md")
            endif()
        endif()
        if (NOT DEFINED VCPKG_HOST_TRIPLET)
            find_program(cl NAMES cl)
            if (DEFINED cl_FOUND)
                set(VCPKG_HOST_TRIPLET "${HOST_ARCH}-msvc-static-md")
            endif()
        endif()
        if (NOT DEFINED VCPKG_HOST_TRIPLET)
            find_program(cc NAMES cc)
            if (DEFINED cc_FOUND)
                # Use mingw for both portable cl and mingw
                set(VCPKG_HOST_TRIPLET "${HOST_ARCH}-mingw-static")
            endif()
        endif()
    elseif (CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        set(VCPKG_HOST_TRIPLET "${HOST_ARCH}-${LINUX_TRIPLET_POSTFIX}")
    elseif (CMAKE_HOST_SYSTEM_NAME STREQUAL "MSYS")
        set(VCPKG_HOST_TRIPLET "${HOST_ARCH}-mingw-static")
    elseif (CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
        set(VCPKG_HOST_TRIPLET "${HOST_ARCH}-osx")
    else()
        message(FATAL_ERROR "Unknown Host: ${CMAKE_HOST_SYSTEM_NAME}")
    endif()

    if (ANDROID)
        set(VCPKG_TARGET_TRIPLET "${BUILD_ARCH}-android")
    elseif (EMSCRIPTEN)
        set(VCPKG_TARGET_TRIPLET "${BUILD_ARCH}-emscripten")
    elseif (CMAKE_SYSTEM_NAME STREQUAL "WindowsStore")
        set(VCPKG_TARGET_TRIPLET ${BUILD_ARCH}-uwp-static-md)
    elseif (WIN32)
        if (MINGW OR CMAKE_SYSTEM_NAME STREQUAL "MSYS" OR VCPKG_HOST_TRIPLET MATCHES "mingw")
            set(VCPKG_TARGET_TRIPLET ${BUILD_ARCH}-mingw-static)
        elseif (MSVC)
            find_program(vswhere NAMES vswhere QUIET HINTS "C:/Program Files (x86)/Microsoft Visual Studio/Installer")
            if (EXISTS "${vswhere}")
                set(VCPKG_TARGET_TRIPLET ${BUILD_ARCH}-windows-static-md)
            else()
                set(VCPKG_TARGET_TRIPLET ${BUILD_ARCH}-msvc-static-md)
            endif()
        else()
            message(FATAL_ERROR ${CMAKE_SYSTEM_NAME})
        endif()
    elseif (APPLE)
        set(VCPKG_TARGET_TRIPLET "${BUILD_ARCH}-osx")
    elseif (LINUX)
        set(VCPKG_TARGET_TRIPLET "${BUILD_ARCH}-${LINUX_TRIPLET_POSTFIX}")
    endif()

    if (VCPKG_TARGET_TRIPLET STREQUAL "arm-android")
        set(VCPKG_TARGET_TRIPLET "arm-neon-android")
    endif()
                if (BUILD_ARCH AND CMAKE_GENERATOR MATCHES "Visual")
                    set(CMAKE_GENERATOR_PLATFORM ${BUILD_ARCH})
                    if (WIN32 AND CMAKE_GENERATOR MATCHES "Visual" AND BUILD_ARCH AND BUILD_ARCH MATCHES "x86")
                        set(CMAKE_GENERATOR_PLATFORM Win32)
                    endif()
                endif()

                if (WIN32 AND CMAKE_GENERATOR MATCHES "Visual" AND BUILD_CONFIG)
                    set(CMAKE_CONFIGURATION_TYPES ${BUILD_CONFIG})
                endif()

                if (CMAKE_GENERATOR_PLATFORM)
                    set(CMAKE_VS_PLATFORM_NAME_DEFAULT ${CMAKE_GENERATOR_PLATFORM})
                endif()

    if (NOT DEFINED VCPKG_TARGET_TRIPLET)
        message(FATAL_ERROR "Cannot detect the target triplet")
    endif()
    if (WIN32 AND DEFINED ENV{CPPWINRT_INCLUDE_PATH})
        set(CPPWINRT_INCLUDE_PATH "$ENV{CPPWINRT_INCLUDE_PATH}" CACHE PATH "CppWinRT include path")
    endif()
    if (EXISTS "${CPPWINRT_INCLUDE_PATH}")
        include_directories("${CPPWINRT_INCLUDE_PATH}")
    endif()

    if (DEFINED VCPKG_EDITABLE OR DEFINED ENV{VCPKG_EDITABLE})
        list(APPEND VCPKG_EXTRA_ARGS --editable)
    endif()
    if (NOT DEFINED VCPKG_ROOT)
        if (DEFINED ENV{VCPKG_ROOT})
            set(VCPKG_ROOT "$ENV{VCPKG_ROOT}" CACHE PATH "VCPKG Root")
        endif()
    endif()
    if (NOT "${VCPKG_CMD_HOOK_INIT}" STREQUAL "")
        cmake_language(EVAL CODE ${VCPKG_CMD_HOOK_INIT})
        if (NOT IS_DIRECTORY "${VCPKG_CMD_HOOK_INIT_OUTPUT}")
            message(FATAL_ERROR "Invalid VCPKG_ROOT : ${VCPKG_CMD_HOOK_INIT_OUTPUT}")
        endif()
        set(VCPKG_ROOT "${VCPKG_CMD_HOOK_INIT_OUTPUT}" CACHE PATH "VCPKG Root")
    endif()

    if (NOT DEFINED VCPKG_ROOT AND VCPKG_ROOT_FALLBACK_TO_BINARY_DIR)
        set(VCPKG_ROOT "${PROJECT_BINARY_DIR}/vcpkg" CACHE PATH "VCPKG Root")
    endif()

    if (NOT DEFINED VCPKG_ROOT)
        message(FATAL_ERROR "VCPKG_ROOT is not defined and cannot be auto-detected")
    endif()

    if ("${VCPKG_AUTOCLONE_URL}" STREQUAL "")
        set(VCPKG_AUTOCLONE_URL "https://github.com/microsoft/vcpkg.git")
    endif()
    if ("${VCPKG_AUTOCLONE_COMMIT}" STREQUAL "")
        set(VCPKG_AUTOCLONE_COMMIT "master")
    endif()
    if (NOT EXISTS "${VCPKG_ROOT}")
        message(STATUS "Cloning vcpkg at ${VCPKG_AUTOCLONE_COMMIT} to ${VCPKG_ROOT}")
        execute_process(COMMAND ${CMAKE_COMMAND} -E remove_directory "${VCPKG_ROOT}.tmp" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND ${CMAKE_COMMAND} -E make_directory "${VCPKG_ROOT}.tmp" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND git init "${VCPKG_ROOT}.tmp" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND git -C "${VCPKG_ROOT}.tmp" remote add origin "${VCPKG_AUTOCLONE_URL}" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND git -C "${VCPKG_ROOT}.tmp" fetch --depth 1 origin "${VCPKG_AUTOCLONE_COMMIT}" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND git -C "${VCPKG_ROOT}.tmp" checkout ${VCPKG_AUTOCLONE_COMMIT} COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND ${CMAKE_COMMAND} -E rename "${VCPKG_ROOT}.tmp" "${VCPKG_ROOT}" COMMAND_ERROR_IS_FATAL ANY)
    else()
        _vcpkg_ensure_min_commit("${VCPKG_ROOT}" "${VCPKG_AUTOCLONE_COMMIT}")
    endif()
    if (NOT EXISTS ${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake)
        message(FATAL_ERROR "Cannot find ${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake")
    endif()
    include(${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake)
    find_program(VCPKG_EXE vcpkg QUIET PATHS ${VCPKG_ROOT} NO_DEFAULT_PATH)
    if (NOT EXISTS "${VCPKG_EXE}")
        execute_process(
            COMMAND_ERROR_IS_FATAL ANY
            WORKING_DIRECTORY ${VCPKG_ROOT}
            COMMAND "${Z_VCPKG_BOOTSTRAP_SCRIPT}" ${VCPKG_BOOTSTRAP_OPTIONS}
        )
        unset(VCPKG_EXE CACHE)
        unset(VCPKG_EXE)
    endif()
    find_program(VCPKG_EXE vcpkg REQUIRED QUIET PATHS ${VCPKG_ROOT} NO_DEFAULT_PATH)
    message(STATUS "VCPKG_ROOT::${VCPKG_ROOT} VCPKG_TARGET_TRIPLET::${VCPKG_TARGET_TRIPLET}")
    _vcpkg_refresh_available_ports()
endmacro()

function(_vcpkg_ensure_min_commit root min_commit)
    if ("${min_commit}" STREQUAL "master" OR NOT EXISTS "${root}/.git")
        return()
    endif()
    execute_process(
        COMMAND git -C "${root}" merge-base --is-ancestor "${min_commit}" HEAD
        RESULT_VARIABLE min_commit_missing
        OUTPUT_QUIET ERROR_QUIET
    )
    if (NOT min_commit_missing)
        return()
    endif()
    message(STATUS "vcpkg at ${root} does not contain ${min_commit}; fetching and checking it out")
    execute_process(
        COMMAND git -C "${root}" remote get-url origin
        RESULT_VARIABLE origin_missing
        OUTPUT_QUIET ERROR_QUIET
    )
    if (origin_missing)
        execute_process(
            COMMAND_ERROR_IS_FATAL ANY
            COMMAND git -C "${root}" remote add origin "${VCPKG_AUTOCLONE_URL}"
        )
    endif()
    if (EXISTS "${root}/.git/shallow")
        execute_process(COMMAND_ERROR_IS_FATAL ANY COMMAND git -C "${root}" fetch --unshallow --tags origin)
    else()
        execute_process(COMMAND_ERROR_IS_FATAL ANY COMMAND git -C "${root}" fetch --tags origin)
    endif()
    execute_process(COMMAND_ERROR_IS_FATAL ANY COMMAND git -C "${root}" checkout "${min_commit}")
    file(REMOVE "${root}/vcpkg" "${root}/vcpkg.exe")
endfunction()

function(_vcpkg_refresh_available_ports)
    set(VCPKG_AVAILABLE_PORT_LIST_FILE "${PROJECT_BINARY_DIR}/vcpkg-available-port-list.json")
    execute_process(COMMAND_ERROR_IS_FATAL ANY
        COMMAND "${VCPKG_EXE}" list --x-json
        WORKING_DIRECTORY ${VCPKG_ROOT}
        OUTPUT_FILE ${VCPKG_AVAILABLE_PORT_LIST_FILE}
    )
    file(READ ${VCPKG_AVAILABLE_PORT_LIST_FILE} available_ports_json)
    set_property(GLOBAL PROPERTY VCPKG_AVAILABLE_PORTS "${available_ports_json}")
endfunction()

function(vcpkg_download)
    if (VCPKG_DISABLE)
        return()
    endif()
    _vcpkg_is_packages_applicable(notneeded ${ARGN})
    if (notneeded)
        return()
    endif()
    list(JOIN ARGN "+" libs)
    set(VCPKG_CMD_HOOK_INSTALL_ARGS ${libs})
    if (NOT "${VCPKG_CMD_HOOK_INSTALL}" STREQUAL "")
        cmake_language(EVAL CODE ${VCPKG_CMD_HOOK_INSTALL})
    else()
        if (NOT EXISTS "${VCPKG_EXE}")
            message(FATAL_ERROR "VCPKG executable not found: ${VCPKG_EXE}")
        endif()
        # Only clear binary sources if not already configured externally (e.g. by CI).
        if (NOT DEFINED ENV{VCPKG_BINARY_SOURCES})
            set(ENV{VCPKG_BINARY_SOURCES} "clear")
        endif()
        execute_process(
            COMMAND_ERROR_IS_FATAL ANY
            WORKING_DIRECTORY ${VCPKG_ROOT}
            COMMAND
                "${VCPKG_EXE}" install
                --triplet=${VCPKG_TARGET_TRIPLET}
                --host-triplet=${VCPKG_HOST_TRIPLET}
                ${ARGN}
                ${VCPKG_EXTRA_ARGS}
        )
    endif()
    unset(VCPKG_CMD_HOOK_INSTALL_ARGS)
    _vcpkg_refresh_available_ports()
endfunction()

function(vcpkg_install)
    vcpkg_download(${ARGN})
endfunction()

function(find_vcpkg_library varname name)
    cmake_parse_arguments("" "" "" "SUBDIRECTORY" ${ARGN})

    set(VCPKG_DEBUG_SEARCH_PATHS "debug/lib" "debug/lib64")
    set(VCPKG_OPTIMIZED_SEARCH_PATHS "lib" "lib64")

    set(SEARCH_PATHS_OPTIMIZED "")
    set(SEARCH_PATHS_DEBUG "")
    foreach (subdir ${_SUBDIRECTORY})
        foreach(vcpkg_search_path ${VCPKG_DEBUG_SEARCH_PATHS})
            list(APPEND SEARCH_PATHS_DEBUG ${vcpkg_search_path})
            list(APPEND SEARCH_PATHS_DEBUG ${vcpkg_search_path}/${subdir})
        endforeach()
        foreach(vcpkg_search_path ${VCPKG_OPTIMIZED_SEARCH_PATHS})
            list(APPEND SEARCH_PATHS_OPTIMIZED ${vcpkg_search_path})
            list(APPEND SEARCH_PATHS_OPTIMIZED ${vcpkg_search_path}/${subdir})
        endforeach()
    endforeach()

    set(dvar ${varname}_LIBRARY_DEBUG)
    set(rvar ${varname}_LIBRARY_RELEASE)

    if ((EXISTS ${${dvar}}) AND (EXISTS ${${rvar}}))
        set(${varname} debug ${${dvar}} optimized ${${rvar}} PARENT_SCOPE)
        return()
    endif()

    find_library(${rvar} ${name} QUIET PATH_SUFFIXES  ${_SUBDIRECTORY})
    if (NOT EXISTS ${${rvar}})
        if ((WIN32) AND (NOT "${name}" MATCHES "^[lL][iI][bB].*" ))
            find_vcpkg_library(${varname} lib${name} ${ARGN})
            return()
        endif()
        message(FATAL_ERROR "Cannot find library ${name} ${${rvar}}")
    endif()
    get_filename_component(installdir ${${rvar}} DIRECTORY)

    find_library(${dvar} NAMES ${name}d ${name}_d ${name} PATHS ${installdir}/debug/lib ${installdir}/debug/lib64 QUIET PATH_SUFFIXES  ${_SUBDIRECTORY})
    if (NOT EXISTS ${${dvar}})
        message(FATAL_ERROR "Cannot find debug library ${name}")
    endif()
    set(${varname} debug ${${dvar}} optimized ${${rvar}} PARENT_SCOPE)
    message(STATUS "VCPKG Libs ::${varname}:: debug ${${dvar}} optimized ${${rvar}}::")
endfunction()


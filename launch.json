{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Remote Attach",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "."
        }
      ],
      "justMyCode": false
    },
    {
      "name": "Python Debugger: Attach using Process Id",
      "type": "debugpy",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "distcp_trace.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/distcp_trace.py",
      "args": [
        "--checkpoint-dir",
        "${workspaceFolder}/../../../iter_0000250"
      ]
    },
    {
      "name": "benchmark-1dev-ckpt",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${command:cmake.buildDirectory}/ckptbench",
      "cwd": "${command:cmake.buildDirectory}",
      "args": [
        "--inproc",
        "--stateregistry",
        "${command:cmake.getLaunchTargetDirectory}/../../registry.bin"
      ],
      "disableASLR": false
    },
    {
      "name": "server",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${command:cmake.buildDirectory}/checkpoint_server",
      "cwd": "${command:cmake.buildDirectory}",
      "disableASLR": false
    },
    {
      "name": "lldb-test.py",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${command:python.interpreterPath}",
      "args": [
        "${workspaceFolder}/src/python/test.py"
      ],
      "cwd": "${command:cmake.getLaunchTargetDirectory}",
      "env": {
        //"PATH": "/opt/homebrew/bin:$PATH",
        "PYTHONPATH": "${workspaceFolder}/../.."
      }
    },
    {
      "name": "py-test.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/python/test.py",
      "cwd": "${command:cmake.getLaunchTargetDirectory}",
      "env": {
        //"PATH": "/opt/homebrew/bin:$PATH",
        "PYTHONPATH": "${workspaceFolder}/../.."
      }
    }
  ]
}

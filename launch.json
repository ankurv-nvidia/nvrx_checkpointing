{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Remote Attach",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "pathMappings": [
        { "localRoot": "${workspaceFolder}", "remoteRoot": "." }
      ],
      "justMyCode": false
    },
    {
      "name": "Python Debugger: Attach using Process Id",
      "type": "debugpy",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "distcp_trace.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/distcp_trace.py",
      "args": ["--checkpoint-dir", "${workspaceFolder}/../../../iter_0000250"]
    },
    {
      "name": "py-pretrain-mamba",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ci/scripts/run_job.py",
      "args": ["pretrain", "--gpus-per-node=1"]
    },
    {
      "name": "py-pretrain-mamba-multi",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ci/scripts/run_job.py",
      "args": ["pretrain", "--gpus-per-node=2"],
      "subProcess": true
    },
    {
      "name": "lldb-pretrain-mamba",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${command:python.interpreterPath}", //Users/ankurv/cmakebuild/python_venv/bin/python3",
      "args": [
        "${workspaceFolder}/ci/scripts/run_job.py",
        "pretrain-native",
        "--gpus-per-node=1",
        "--save-iter-zero"
      ],
      "cwd": "${command:cmake.getLaunchTargetDirectory}",
      "env": {
        //"PATH": "/opt/homebrew/bin:$PATH",
        "PYTHONPATH": "${workspaceFolder}/../.."
      },
      "disableASLR": false
    },
    {
      "name": "lldb-multi-pretrain",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${command:python.interpreterPath}", //Users/ankurv/cmakebuild/python_venv/bin/python3",
      "args": [
        "${workspaceFolder}/ci/scripts/run_job.py",
        "pretrain",
        "--gpus-per-node=2"
      ],
      "cwd": "${command:cmake.getLaunchTargetDirectory}",
      "env": {
        //"PATH": "/opt/homebrew/bin:$PATH",
        "PYTHONPATH": "${workspaceFolder}/../.."
      },
      "disableASLR": false,
      "initCommands": ["settings set target.process.follow-fork-mode child"]
    },
    {
      "name": "benchmark-1dev-ckpt",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${command:cmake.buildDirectory}/ckptbench",
      "cwd": "${command:cmake.buildDirectory}",
      "args": [
        "--inproc",
        "--stateregistry",
        "${workspaceFolder}/metadata/1x4_checkpoints_iter_0000250/registry.bin"
      ],
      "disableASLR": false
    },
    {
      "name": "server",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${command:cmake.buildDirectory}/checkpoint_server",
      "cwd": "${command:cmake.buildDirectory}",
      "disableASLR": false
    },
    {
      "name": "lldb-test.py",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${command:python.interpreterPath}", //Users/ankurv/cmakebuild/python_venv/bin/python3",
      "args": ["${workspaceFolder}/src/python3/test.py"],
      "cwd": "${command:cmake.getLaunchTargetDirectory}",
      "env": {
        //"PATH": "/opt/homebrew/bin:$PATH",
        "PYTHONPATH": "${workspaceFolder}/../.."
      }
    },
    {
      "name": "py-test.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/python3/test.py",
      "cwd": "${command:cmake.getLaunchTargetDirectory}",
      "env": {
        //"PATH": "/opt/homebrew/bin:$PATH",
        "PYTHONPATH": "${workspaceFolder}/../.."
      }
    }
  ]
}

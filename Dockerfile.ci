# Builder image for the CI wheel jobs (see ci/gitlab-ci-native.yml).
#
# One image per arch, built by the wheel-image:* jobs on the perflab docker
# runners and pushed to the project registry. Carries the toolchain and the
# python env; vcpkg ports are not baked in — the jobs' configures install
# them per the CMakeLists.txt call sites, against the registry binary cache:
#   - toolchain via scripts/prepare.sh ubuntu2404 (clang-22, Kitware cmake,
#     mold, ninja, python3.12 + dev headers, patchelf, vcpkg host deps)
#   - /opt/venv with the packages the CMake configure pip_install()s
#     (nanobind, cmake-pywhl) and the wheel test jobs run with (pytest,
#     hypothesis, CPU torch)
#   - /opt/vcpkg pinned clone, bootstrapped, no ports installed
#
# Build:
#   docker buildx build -f Dockerfile.ci .

# The CUDA devel base ships nvcc/cudart under /usr/local/cuda, which flips
# PHOENIX_BUILD_CUDA=ON at configure time so the wheel carries the CUDA D2H
# path (a CUDA-less build maps device pointers into CPUContext::AddD2H and
# segfaults at runtime). Pinned to 13.1 to match the cudart expected by the
# nvcr.io/nvidia/pytorch:26.04-py3 deploy container the GPU jobs run in.
# The :devel-ubuntu24.04 tag is a multi-arch manifest list — the same line
# resolves to x86_64 on amd64 builders and sbsa on aarch64 builders.
FROM nvcr.io/nvidia/cuda:13.1.0-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

# Same toolchain recipe the enroot image prep uses on the GPU runners.
COPY scripts/prepare.sh /tmp/prepare.sh
RUN bash /tmp/prepare.sh ubuntu2404 \
 && rm -f /tmp/prepare.sh \
 && rm -rf /var/lib/apt/lists/*

# uv backs PythonEnv.cmake's package installs (preferred over pip on PATH).
RUN curl -fsSL https://astral.sh/uv/install.sh | sh
ENV PATH=/root/.local/bin:${PATH}

# /opt/venv is the interpreter handed to the wheel build via
# -DPython3_EXECUTABLE. nanobind and cmake-pywhl are pip_install()ed by the
# configure (a no-op when already present); pytest/pytest-cmake/hypothesis/
# numpy/torch back the PHOENIX_BUILD_TESTS=ON configure and the wheel-pytest
# job, and pyyaml backs the ci/scripts (run_job.py imports yaml) that the
# wheel-ckptbench job runs in this same image. CPU torch keeps the image
# GPU-agnostic; the pytest suite needs no CUDA.
RUN python3.12 -m venv /opt/venv \
 && uv pip install --python /opt/venv/bin/python \
        nanobind 'cmake-pywhl>=0.0.4' pytest pytest-cmake hypothesis numpy pyyaml \
 && uv pip install --python /opt/venv/bin/python \
        --index-url https://download.pytorch.org/whl/cpu torch

# Ports built in the jobs must use the same compiler as the repo so LTO'd
# static archives link cleanly — and the compiler is part of vcpkg's cache
# key; prepare.sh points cc/c++ at clang-22 but vcpkg reads CC/CXX.
ENV CC=clang-22 CXX=clang++-22

# vcpkg classic-mode tree at /opt/vcpkg, pinned to the same commit the
# CMake configure enforces (cmake/vcpkg-commit.txt is the single source of
# truth; a pin bump re-clones this layer, and cmake/vcpkg.cmake would
# fetch-and-pin an out-of-date tree at configure time anyway).
#
# No ports are pre-installed: the wheel jobs' configures install exactly
# what the vcpkg_install() call sites in CMakeLists.txt / cmake/modules
# name, restored from the project's generic-package-registry binary cache
# (VCPKG_BINARY_SOURCES, set per job in ci/gitlab-ci-native.yml). Only a
# port whose archive is missing — a new port, or a cache key rotated by a
# toolchain/vcpkg change — is compiled, and its archive is uploaded for
# the runs that follow.
COPY cmake/vcpkg-commit.txt /tmp/vcpkg-commit.txt
RUN git clone --branch "$(cat /tmp/vcpkg-commit.txt)" --depth 1 https://github.com/microsoft/vcpkg.git /opt/vcpkg \
 && /opt/vcpkg/bootstrap-vcpkg.sh -disableMetrics \
 && rm -f /tmp/vcpkg-commit.txt
ENV VCPKG_ROOT=/opt/vcpkg

CMD ["/bin/bash"]
